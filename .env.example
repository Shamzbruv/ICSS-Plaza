PORT=3000
# Optional: production falls back to https://RAILWAY_PUBLIC_DOMAIN when blank.
BASE_URL=
DATA_DIR=./data
# Optional: exactly 64 hexadecimal characters. When blank on a fresh database,
# a private key is generated at DATA_DIR/.encryption-key and reused on restart.
# Keep DATA_DIR on persistent storage and include the key in protected backups.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Set these together to bootstrap the platform operator. No default password.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
# Enable only behind a trusted reverse proxy (e.g. Railway).
TRUST_PROXY=0
NODE_ENV=development
