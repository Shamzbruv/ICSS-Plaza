PORT=3000
# Optional: production falls back to https://RAILWAY_PUBLIC_DOMAIN when blank.
BASE_URL=
DATA_DIR=./data
# Optional: exactly 64 hexadecimal characters. When blank on a fresh database,
# a private key is generated at DATA_DIR/.encryption-key and reused on restart.
# Keep DATA_DIR on persistent storage and include the key in protected backups.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Set these together to bootstrap the platform operator. No default password.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
# Enable only behind a trusted reverse proxy (e.g. Railway).
TRUST_PROXY=0
NODE_ENV=development

# Optional: server-only Postgres connection string (Supabase session pooler).
# Postgres also requires a stable ENCRYPTION_KEY. See the cutover guide.
DATABASE_URL=
REQUIRE_POSTGRES=0

# Resend transactional sending. Use a verified domain and an HTTPS public origin.
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Optional: receive support replies at one Resend inbound address.
RESEND_INBOX_ADDRESS=
RESEND_INBOUND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ICSS Plaza rental billing only. Vendor checkout uses its own credentials.
PLAZA_FYGARO_LINK=
PLAZA_FYGARO_KEY_ID=
PLAZA_FYGARO_SECRET=
PLAZA_PAYPAL_MODE=sandbox
PLAZA_PAYPAL_CLIENT_ID=
PLAZA_PAYPAL_SECRET=
PLAZA_PAYPAL_WEBHOOK_ID=
