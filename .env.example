PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=./data
# Exactly 64 hexadecimal characters; required before storing gateway credentials.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Set these together to bootstrap the platform operator. No default password.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
# Enable only behind a trusted reverse proxy (e.g. Railway).
TRUST_PROXY=0
NODE_ENV=development
